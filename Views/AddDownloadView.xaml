<Page x:Class="FFmpegDownloader.Views.AddDownloadView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:FFmpegDownloader.ViewModels"
      xmlns:local="clr-namespace:FFmpegDownloader.Markup"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:AddDownloadViewModel}">

    <StackPanel Margin="32">

        <!-- Header -->
        <TextBlock Text="{local:Translate AddDownload}"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,8" />

        <TextBlock Text="{local:Translate AddDownloadDescription}"
                   FontSize="14"
                   Foreground="#A0A0A0"
                   Margin="0,0,0,32" />

        <!-- Main information -->
        <TextBlock Text="{local:Translate DownloadInformation}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,12" />

        <Border Background="#252525"
                CornerRadius="8"
                Padding="20">

            <StackPanel>

                <!-- Playlist URL -->
                <TextBlock Text="{local:Translate PlaylistUrl}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <TextBox Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="10,6"
                         Margin="0,0,0,20" />

                <!-- Output path -->
                <TextBlock Text="{local:Translate OutputPath}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,6"
                             Margin="0,0,10,0" />

                    <Button Grid.Column="1"
                            Content="{local:Translate Browse}"
                            Click="BrowseOutputFile"
                            Height="36"
                            Padding="16,0" />
                </Grid>

                <!-- Action -->
                <Grid>
                    <Button Content="{local:Translate AddToQueue}"
                            Command="{Binding AddDownloadCommand}"
                            HorizontalAlignment="Right"
                            Height="36"
                            Padding="24,0"
                            MinWidth="180" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- Advanced options -->
        <ui:CardExpander Header="{local:Translate AdvancedOptions}"
                         Margin="0,20,0,0"
                         CornerRadius="8"
                         ContentPadding="20">

            <TextBlock Text="{local:Translate AdvancedOptionsDescription}"
                       Foreground="#A0A0A0"
                       TextWrapping="Wrap" />

        </ui:CardExpander>

    </StackPanel>

</Page>
