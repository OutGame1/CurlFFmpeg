<Page x:Class="CurlFFmpeg.Views.AddDownloadView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:CurlFFmpeg.ViewModels"
      xmlns:local="clr-namespace:CurlFFmpeg.Markup"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:AddDownloadViewModel}">

    <StackPanel Margin="32">

        <!-- Header -->
        <TextBlock Text="{local:Translate AddDownload}"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,8" />

        <TextBlock Text="{local:Translate AddDownloadDescription}"
                   FontSize="14"
                   Foreground="#A0A0A0"
                   Margin="0,0,0,32" />

        <!-- Main information -->
        <TextBlock Text="{local:Translate DownloadInformation}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,12" />

        <Border Background="#252525"
                CornerRadius="8"
                Padding="20">

            <StackPanel>

                <!-- cURL command -->
                <TextBlock Text="{local:Translate CurlCommand}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <TextBox Text="{Binding CurlCommand, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="180"
                         MaxHeight="300"
                         Padding="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         Margin="0,0,0,20" />

                <!-- Output file -->
                <TextBlock Text="{local:Translate OutputFile}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding OutputFile, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,6"
                             Margin="0,0,10,0" />

                    <Button Grid.Column="1"
                            Content="{local:Translate Browse}"
                            Height="36"
                            Padding="16,0" />
                </Grid>

                <!-- Format and action -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{local:Translate OutputFormat}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <ComboBox ItemsSource="{Binding AvailableFormats}"
                                  SelectedItem="{Binding Format, Mode=TwoWay}"
                                  Height="36"
                                  MinWidth="180" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{local:Translate AddToQueue}"
                            Command="{Binding AddDownloadCommand}"
                            VerticalAlignment="Bottom"
                            Height="36"
                            Padding="24,0"
                            MinWidth="180" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- Advanced options -->
        <ui:CardExpander Header="{local:Translate AdvancedOptions}"
                         Margin="0,20,0,0"
                         CornerRadius="8"
                         ContentPadding="20">

            <TextBlock Text="{local:Translate AdvancedOptionsDescription}"
                       Foreground="#A0A0A0"
                       TextWrapping="Wrap" />

        </ui:CardExpander>

    </StackPanel>

</Page>
