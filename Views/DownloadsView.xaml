<Page x:Class="FFmpegDownloader.Views.DownloadsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:FFmpegDownloader.ViewModels"
      xmlns:local="clr-namespace:FFmpegDownloader.Markup"
      xmlns:enums="clr-namespace:FFmpegDownloader.Enums"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}">

    <Grid Margin="32">

        <Grid.Resources>

            <!-- Couleurs -->
            <SolidColorBrush x:Key="PrimaryTextBrush"
                             Color="#F5F5F5" />
            <SolidColorBrush x:Key="SecondaryTextBrush"
                             Color="#A1A7B0" />

            <!-- Carte d'un téléchargement -->
            <Style x:Key="DownloadCard"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="#22252B" />
                <Setter Property="BorderBrush"
                        Value="#353A43" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="12" />
                <Setter Property="Padding"
                        Value="18" />
                <Setter Property="Margin"
                        Value="0,0,0,12" />
            </Style>

            <!-- Badge de statut -->
            <Style x:Key="StatusBadge"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="#343A44" />
                <Setter Property="CornerRadius"
                        Value="8" />
                <Setter Property="Padding"
                        Value="10,5" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <!-- Barre de progression : masquée par défaut -->
            <Style x:Key="DownloadProgressStyle"
                   TargetType="ProgressBar">
                <Setter Property="Height"
                        Value="7" />
                <Setter Property="Margin"
                        Value="0,14,0,0" />
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static enums:DownloadStatus.Downloading}">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Pourcentage : masqué par défaut -->
            <Style x:Key="DownloadProgressTextStyle"
                   TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="HorizontalAlignment"
                        Value="Right" />
                <Setter Property="Margin"
                        Value="0,6,0,0" />
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static enums:DownloadStatus.Downloading}">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Carte d'un élément de la file -->
            <DataTemplate x:Key="DownloadItemTemplate">

                <Border x:Name="Card"
                        Style="{StaticResource DownloadCard}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Indicateur coloré du statut -->
                        <Border x:Name="StatusIndicator"
                                Grid.Column="0"
                                Background="#7D8795"
                                CornerRadius="2"
                                Margin="0,2,0,2" />

                        <Grid Grid.Column="1"
                              Margin="16,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Nom, statut et suppression -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding FileName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <Border x:Name="StatusBadge"
                                        Grid.Column="1"
                                        Style="{StaticResource StatusBadge}"
                                        Margin="12,0,12,0">
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#E5E7EB" />
                                </Border>

                                <Button Grid.Column="2"
                                        Content="✕"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        ToolTip="{local:Translate Delete}"
                                        Command="{Binding DataContext.RemoveDownloadCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}" />
                            </Grid>

                            <!-- URL -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Url}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       Margin="0,9,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Progression -->
                            <StackPanel Grid.Row="2">
                                <ProgressBar Value="{Binding Progress}"
                                             Maximum="100"
                                             Style="{StaticResource DownloadProgressStyle}" />

                                <TextBlock Text="{Binding Progress, StringFormat={}{0:F0} %}"
                                           Style="{StaticResource DownloadProgressTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Couleurs selon le statut -->
                <DataTemplate.Triggers>

                    <!-- En attente -->
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static enums:DownloadStatus.Pending}">
                        <Setter TargetName="StatusIndicator"
                                Property="Background"
                                Value="#7D8795" />
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="#343A44" />
                    </DataTrigger>

                    <!-- En cours -->
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static enums:DownloadStatus.Downloading}">
                        <Setter TargetName="StatusIndicator"
                                Property="Background"
                                Value="#3B9EFF" />
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="#164B78" />
                        <Setter TargetName="Card"
                                Property="BorderBrush"
                                Value="#286BA3" />
                    </DataTrigger>

                    <!-- Terminé -->
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static enums:DownloadStatus.Completed}">
                        <Setter TargetName="StatusIndicator"
                                Property="Background"
                                Value="#42B883" />
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="#1D5942" />
                    </DataTrigger>

                    <!-- Erreur -->
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static enums:DownloadStatus.Failed}">
                        <Setter TargetName="StatusIndicator"
                                Property="Background"
                                Value="#E05D5D" />
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="#692F35" />
                    </DataTrigger>

                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Message lorsque la liste est vide -->
            <Style x:Key="EmptyDownloadsStyle"
                   TargetType="Border">
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Downloads.Count}"
                                 Value="0">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- En-tête -->
                <StackPanel>
                    <TextBlock Text="{local:Translate Downloads}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Text="{local:Translate DownloadsDescription}"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- Contrôles de la file -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,24,0,24">

                    <Button Content="{local:Translate StartQueue}"
                            Command="{Binding StartQueueCommand}"
                            Margin="0,0,12,0"
                            Padding="16,9" />

                    <Button Content="{local:Translate StopQueue}"
                            Command="{Binding StopQueueCommand}"
                            Padding="16,9" />

                </StackPanel>

                <!-- Liste vide -->
                <Border Style="{StaticResource EmptyDownloadsStyle}"
                        Background="#22252B"
                        BorderBrush="#353A43"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="32"
                        Margin="0,0,0,12">

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{local:Translate EmptyDownloads}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{local:Translate EmptyDownloadsDescription}"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Liste des téléchargements -->
                <ItemsControl ItemsSource="{Binding Downloads}"
                              ItemTemplate="{StaticResource DownloadItemTemplate}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
