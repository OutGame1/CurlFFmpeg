<Page x:Class="FFmpegDownloader.Views.DownloadsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:FFmpegDownloader.ViewModels"
      xmlns:local="clr-namespace:FFmpegDownloader.Markup"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}">

    <Grid Margin="32">

        <Grid.Resources>

            <!-- Couleurs -->
            <SolidColorBrush x:Key="PrimaryTextBrush"
                             Color="#F5F5F5" />
            <SolidColorBrush x:Key="SecondaryTextBrush"
                             Color="#AFAFAF" />

            <!-- Style des cartes -->
            <Style x:Key="DownloadCard"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="#252525" />
                <Setter Property="CornerRadius"
                        Value="8" />
                <Setter Property="Padding"
                        Value="20" />
                <Setter Property="Margin"
                        Value="0,0,0,12" />
            </Style>

            <!-- Style des badges -->
            <Style x:Key="StatusBadge"
                   TargetType="Border">
                <Setter Property="CornerRadius"
                        Value="12" />
                <Setter Property="Padding"
                        Value="10,4" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="Margin"
                        Value="16,0,0,0" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="{local:Translate Downloads}"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />

            <TextBlock Text="{local:Translate DownloadsDescription}"
                       FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,6,0,0" />

        </StackPanel>

        <!-- Résumé -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,28,0,24">

            <Border Background="#252525"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,12,0">

                <StackPanel>
                    <TextBlock Text="{local:Translate DownloadStatusPending}"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding PendingCount}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

            </Border>

            <Border Background="#252525"
                    CornerRadius="8"
                    Padding="18"
                    Margin="6,0">

                <StackPanel>
                    <TextBlock Text="{local:Translate DownloadStatusDownloading}"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding DownloadingCount}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

            </Border>

            <Border Background="#252525"
                    CornerRadius="8"
                    Padding="18"
                    Margin="12,0,0,0">

                <StackPanel>
                    <TextBlock Text="{local:Translate DownloadStatusCompleted}"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding CompletedCount}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- Liste dynamique -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Downloads}">

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border Style="{StaticResource DownloadCard}">

                        <StackPanel>

                            <!-- Nom et statut -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        Style="{StaticResource StatusBadge}"
                                        Background="#383838">

                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="#D0D0D0"
                                               FontSize="12"
                                               FontWeight="SemiBold" />

                                </Border>
                            </Grid>

                            <!-- URL -->
                            <TextBlock Text="{Binding Url}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,8,0,12"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Progression -->
                            <ProgressBar Value="{Binding Progress}"
                                         Maximum="100"
                                         Height="6" />

                            <!-- Informations de progression -->
                            <DockPanel Margin="0,8,0,0">

                                <TextBlock Text="{Binding Progress, StringFormat={}{0:F0} %}"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                            </DockPanel>

                            <Grid Margin="0,12,0,0">
                                <Button Content="{local:Translate Delete}"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.RemoveDownloadCommand,
                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}" />
                            </Grid>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>

</Page>
